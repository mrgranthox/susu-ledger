PORT=8080
NODE_ENV=production
# Prefer structured DB settings in production so special characters in passwords
# never break URL parsing. DATABASE_URL is still supported for local development.
DATABASE_URL=postgresql://postgres:secret@localhost:5432/susu_ledger
DB_HOST=/cloudsql/susu-ledger-c3daa:africa-south1:susu-db-instance
DB_NAME=susu_ledger_db
DB_USER=postgres
DB_PASSWORD=
DB_PORT=5432
CLOUD_SQL_CONNECTION_NAME=susu-ledger-c3daa:africa-south1:susu-db-instance
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
META_WHATSAPP_ACCESS_TOKEN=your_access_token
META_WEBHOOK_VERIFY_TOKEN=susu_webhook_secret_token_2026
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_PUBLIC_KEY=pk_test_placeholder
SECRET_SALT=your_random_salt_string
META_APP_SECRET=replace_in_secret_manager
